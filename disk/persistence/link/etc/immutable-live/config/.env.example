# ==============================================================================
# .env.example — шаблон личных значений
# Скопируйте в .env и заполните:  cp .env.example .env
# ==============================================================================

# --- Система (system.ini) ----------------------------------------------------
HOSTNAME=
LOCALE=ru_RU.UTF-8
LANGUAGE=ru_RU:ru
KEYBOARD_LAYOUT=us,ru
KEYBOARD_OPTIONS=grp:alt_shift_toggle
# Значения с пробелами обязательно заключайте в кавычки
DNS_SERVERS="1.1.1.1 8.8.8.8"

# --- Пользователь (user.ini) -------------------------------------------------
USER_NAME=live
USER_PASSWORD_HASH=''
USER_SHELL=/bin/bash
USER_GROUPS=sudo,audio,video,plugdev,netdev
HIDE_USER=false
DISABLE_LIVE_USER=false

# --- Подкачка (swap.ini) -----------------------------------------------------
SWAP_ENABLE=true
SWAP_FILE=/var/swap/swapfile
SWAP_SIZE=2G
SWAPPINESS=10

# --- Время (time.ini) --------------------------------------------------------
TIMEZONE=
NTP_ENABLE=true
NTP_SERVER=pool.ntp.org

# --- Дополнительные ISO-зависимые пути --------------------------------------
# Дополнительные пути (разделенные пробелом) для автоматической очистки при смене ISO
ISO_DEPENDENT_DIRS=
