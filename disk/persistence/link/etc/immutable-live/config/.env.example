# ==============================================================================
# .env.example - personal configuration template
# Copy to .env and fill in:  cp .env.example .env
# ==============================================================================

# --- System --------------------------------------------------------------
HOSTNAME=
LOCALE=ru_RU.UTF-8
LANGUAGE=ru_RU:ru
KEYBOARD_LAYOUT=us,ru
KEYBOARD_OPTIONS=grp:alt_shift_toggle
# Values with spaces MUST be quoted
DNS_SERVERS="1.1.1.1 8.8.8.8"

# --- User ----------------------------------------------------------------
USER_NAME=live
# Password hash from:  mkpasswd -m sha-512  (single-quoted, see below)
USER_PASSWORD_HASH=''
USER_SHELL=/bin/bash
USER_GROUPS=sudo,audio,video,plugdev,netdev
HIDE_USER=false
DISABLE_LIVE_USER=false

# --- Swap ----------------------------------------------------------------
SWAP_ENABLE=true
SWAP_FILE=/var/swap/swapfile
SWAP_SIZE=2G
SWAPPINESS=60

# --- Time ----------------------------------------------------------------
TIMEZONE=
NTP_ENABLE=true
NTP_SERVER=pool.ntp.org

# --- Additional ISO-dependent paths ----------------------------------------
# Extra paths (space-separated) cleaned automatically on ISO change.
# These are merged with the built-in list in immutable-live.sh.
ISO_DEPENDENT_DIRS=